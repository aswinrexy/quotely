# Quotely frontend configuration
#
# Copy this file to .env.local for local development:
#   cp .env.local.example .env.local
#
# .env.local is git-ignored and must never be committed.
#
# ---------------------------------------------------------------------------
# EVERY variable here is NEXT_PUBLIC_, which means Next.js inlines it into the
# JavaScript sent to the browser. Anyone can read it with View Source.
#
# NEVER put a secret behind a NEXT_PUBLIC_ prefix: not the Razorpay key secret,
# not the webhook secret, not the JWT signing key, not a database connection
# string. Those belong to the API and live only on the server.
#
# The Razorpay *Key ID* the checkout needs is public by design, and the browser
# receives it from the API at payment time — it is deliberately not configured
# here, so there is no Razorpay setting in the frontend at all.
# ---------------------------------------------------------------------------

# Base URL of the Quotely ASP.NET Core API.
#
#   DEV   http://localhost:5199   (matches `dotnet run --urls http://localhost:5199`)
#   TEST  https://<test-api-host>
#   UAT   https://<uat-api-host>
#   PROD  https://<prod-api-host>
#
# In TEST/UAT/PROD this is set in the hosting platform's environment settings at
# build time, not in a file. See docs/environments.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5199
