# Cloudflare Pages routing for a statically exported Next.js app.
#
# Quotely renders entirely in the browser, so every page is a static file. Next still requires a
# dynamic segment to be enumerated at build time, so each one is exported once under a placeholder
# ("/q/token", "/customers/id") and the rules below serve that page for any real value. The page
# then reads the actual segment out of the address bar — see lib/route-param.ts.
#
# Three properties of Cloudflare's matching shape this file, and all three were learned the hard
# way from a live deployment:
#
#   1. A rule is followed even when a static asset matches the request. So the literal routes have
#      to appear before the placeholder rules that would otherwise capture them.
#   2. The first matching rule wins, and ":name" matches exactly one path segment.
#   3. NEVER point a rule at a ".html" file. Pages strips the extension and answers 308 to the
#      extensionless URL, which re-matches this file's rules and loops until the browser gives up.
#      Status 200 against an extensionless path is a true rewrite: the content is served in place,
#      the address bar keeps the real URL — which is the whole point, because that URL carries the
#      token — and the rules are not consulted again.

# ---- literal routes that a ":id" rule would otherwise capture -------------
/customers/new         /customers/new         200
/invoices/new          /invoices/new          200
/products/new          /products/new          200
/quotations/new        /quotations/new        200

# ---- customer-facing links (the ones that get shared) --------------------
/q/:token              /q/token               200
/i/:token              /i/token               200

# ---- authenticated record pages ------------------------------------------
/customers/:id/edit    /customers/id/edit     200
/customers/:id         /customers/id          200
/invoices/:id/edit     /invoices/id/edit      200
/invoices/:id          /invoices/id           200
/products/:id/edit     /products/id/edit      200
/quotations/:id/edit   /quotations/id/edit    200
/quotations/:id        /quotations/id         200
