{
  // UAT — the production-like environment the business signs off in.
  //
  // Configured exactly as PROD is, with one deliberate exception: Razorpay stays
  // in Test Mode, so acceptance testing cannot move real money. Every secret comes
  // from environment variables; see docs/environments.md.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    // Supabase PostgreSQL, as PROD uses. Override with Database__Provider to
    // point an environment back at SQL Server.
    "Provider": "Postgres",
    // Applied as an explicit deployment step, the same as PROD, so the release
    // rehearsal matches the real thing.
    "AutoMigrate": false
  },
  "Seed": {
    "Enabled": false
  }
}
