{
  // TEST — the shared integration environment QA works against.
  //
  // Non-secret settings only. The connection string, the JWT key, the Razorpay
  // credentials, the CORS origins and the public link base URL all arrive as
  // environment variables; see docs/environments.md for the full list.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    // Migrations are applied on start-up so a QA database always matches the
    // build being tested. UAT and PROD apply them deliberately instead.
    "AutoMigrate": true
  },
  "Seed": {
    // TEST holds QA data created by testers, not the demo account.
    "Enabled": false
  }
}
