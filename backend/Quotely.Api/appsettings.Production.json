{
  // PRODUCTION — real customers, real money.
  //
  // Nothing sensitive is in this file and nothing sensitive may ever be added to
  // it. The connection string, the JWT key and the Razorpay credentials are supplied
  // by the host's secret store as environment variables; see docs/environments.md.
  //
  // The first public deployment runs Razorpay in TEST mode. Going Live is a separate,
  // deliberate step — see docs/hosting.md.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    // Supabase PostgreSQL on the free tier. This is startup infrastructure, not the
    // final architecture; SQL Server support is intact behind Database__Provider.
    // See docs/hosting.md.
    "Provider": "Postgres",
    // Never on start-up. A production schema change is a deliberate, reviewed
    // step taken against a backup — see "Applying migrations" in the docs.
    "AutoMigrate": false
  },
  "Seed": {
    // No demo account, ever.
    "Enabled": false
  }
}
